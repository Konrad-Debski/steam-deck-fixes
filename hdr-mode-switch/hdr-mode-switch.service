[Unit]
Description=Switch to an HDR-capable display mode while HDR is on (Game Mode)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 -I %h/.local/share/hdr-mode-switch/hdr_mode_switch.py
EnvironmentFile=%t/gamescope-environment
Restart=always
RestartSec=3

[Install]
WantedBy=gamescope-session.target
