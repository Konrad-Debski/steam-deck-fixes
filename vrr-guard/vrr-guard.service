[Unit]
Description=Keep VRR off in display modes where the dock loses the signal (Game Mode)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 -I %h/.local/share/vrr-guard/vrr_guard.py
EnvironmentFile=%t/gamescope-environment
Restart=always
RestartSec=3

[Install]
WantedBy=gamescope-session.target
